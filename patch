+    erasures[i] = (MOA_Random_W(w, 1))%(k+m);
+    if (erased[erasures[i]] == 0) {
+      erased[erasures[i]] = 1;
+	  
+      bzero((erasures[i] < k) ? data[erasures[i]] : coding[erasures[i]-k], size);
+      i++;
+    }
+  }
