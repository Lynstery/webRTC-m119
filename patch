+
+    int32x4_t delta[6][2];
+    int32_t single_delta[6];
+
+    delta[0][0] = horizontal_add_4d_s32x4(&deltas[0][0]);
+    delta[1][0] = horizontal_add_4d_s32x4(&deltas[1][0]);
