+absl::optional<int64_t> VideoStreamBufferController::InsertFrame(
+    std::unique_ptr<EncodedFrame> frame) {
+  RTC_DCHECK_RUN_ON(&worker_sequence_checker_);
+  FrameMetadata metadata(*frame);
+
+  // Calculate deadline for this frame
+  Timestamp now = clock_->CurrentTime();
+  Timestamp deadline = timing_->ActualRenderTime(metadata.rtp_timestamp, now);
+
+  if (buffer_->InsertFrame(std::move(frame), deadline)) {  // Pass deadline
+    RTC_DCHECK(metadata.receive_time) << "Frame receive time must be set!";
+    if (!metadata.delayed_by_retransmission && metadata.receive_time &&
+        (field_trials_.IsDisabled("WebRTC-IncomingTimestampOnMarkerBitOnly") ||
+         metadata.is_last_spatial_layer)) {
+      timing_->IncomingTimestamp(metadata.rtp_timestamp,
+                                 *metadata.receive_time);
+    }
+    // Check if new decodable frame available
+    if (buffer_->NextDecodableFrameInfo()) {
+      stats_proxy_->OnCompleteFrame(metadata.is_keyframe, metadata.size,
+                                    metadata.contentType);
+      MaybeScheduleFrameForRelease();
+    }
+  }
+  // return nullopt to disable nack module clearUpto functionality
+  return absl::nullopt;
+}
