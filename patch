+  int i, j, x;
+  int n, sp;
+
+  if(k > m) n = k;
+  else n = m;
+  sp = size * 2 + size/(w/8) + 8;
+
+  printf("%-*sCoding\n", sp, "Data");
+  for(i = 0; i < n; i++) {
+	  if(i < k) {
+		  printf("D%-2d:", i);
+		  for(j=0;j< size; j+=(w/8)) { 
