+			  }
+		  }
+		  printf("    ");
+	  }
+	  else printf("%*s", sp, "");
+	  if(i < m) {
+		  printf("C%-2d:", i);
+		  for(j=0;j< size; j+=(w/8)) { 
+			  printf(" ");
+			  for(x=0;x < w/8;x++){
