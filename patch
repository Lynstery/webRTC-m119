+static inline vuint32m1_t fold_mul_and_sum_pairwise_rvv(vint16m1_t partiala,
+                                                        vint16m1_t partialb,
+                                                        vint16m1_t partialc,
+                                                        vuint32m1_t const0) {
+  vuint16m1_t vid_u16m1 = __riscv_vid_v_u16m1(4);
