+  jerasure_print_matrix(matrix, m, k, w);
+  printf("</pre>\n");
+
+  bitmatrix = jerasure_matrix_to_bitmatrix(k, m, w, matrix);
+
+  no = 0;
+  for (i = 0; i < k*m; i++) {
+    no += cauchy_n_ones(matrix[i], w);
+  }
