+template <>
+struct RoundShiftTraits<false> {
+  template <int Bit, typename D>
+  HWY_ATTR HWY_INLINE static hn::VFromD<D> Shift(D int_tag,
+                                                 hn::VFromD<D> value) {
+    const auto round = hn::Set(int_tag, 1 << (-Bit - 1));
+    return hn::ShiftRight<-Bit>(hn::Add(value, round));
+  }
+};
