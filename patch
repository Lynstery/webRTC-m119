+template <int Bit, typename D>
+HWY_ATTR HWY_INLINE hn::VFromD<D> RoundShift(D int_tag, hn::VFromD<D> value) {
+  return RoundShiftTraits<(Bit >= 0)>::template Shift<Bit>(int_tag, value);
+}
