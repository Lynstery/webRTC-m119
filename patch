+  partial6_s32 = __riscv_vadd_vv_i32m2(partial6_s32, tmp1_i32m2, 4);
+
+  // Reverse partial B.
+  // pattern = { 6, 5, 4, 3, 2, 1, 0, 7, }.
+  vuint32m1_t costs_0, costs_1, costs_2, costs_3;
