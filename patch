+  fprintf(stderr, "       w must be 8, 16 or 32.  Sets up an array of 4 random words in\n");
+  fprintf(stderr, "       GF(2^w) and multiplies them by two.  \n");
+  fprintf(stderr, "       \n");
+  fprintf(stderr, "This demonstrates: reed_sol_galois_w08_region_multby_2()\n");
