+  vint16m1_t partial3a_rv =
+      __riscv_vrgather_vv_i16m1(partial3a, index_pair_u16m1, 8);
+  costs_3 =
+      fold_mul_and_sum_pairwise_rvv(partial3c, partial3b, partial3a_rv, const2);
