+  }
+  return reinterpret_cast<const aom::AV1RateControlRTC *>(controller)
+      ->GetLoopfilterLevel();
+}
+
+AomFrameDropDecision av1_ratecontrol_rtc_compute_qp(
+    AomAV1RateControlRTC *controller,
