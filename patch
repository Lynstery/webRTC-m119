+        d_ie[1] = vandq_s16(d_ie[1], mask[1]);
+        d_ie[2] = vandq_s16(d_ie[2], mask[0]);
+        d_ie[3] = vandq_s16(d_ie[3], mask[1]);
+        d_ie[4] = vandq_s16(d_ie[4], mask[0]);
+        d_ie[5] = vandq_s16(d_ie[5], mask[1]);
+        d_ie[6] = vandq_s16(d_ie[6], mask[0]);
