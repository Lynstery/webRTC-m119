+static int get_mv_err(MV cur_mv, MV ref_mv) {
+  const MV diff = { cur_mv.row - ref_mv.row, cur_mv.col - ref_mv.col };
+  const MV abs_diff = { abs(diff.row), abs(diff.col) };
+  const int mv_err = (abs_diff.row + abs_diff.col);
+  return mv_err;
+}
