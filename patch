+void DynamicStructureController::OnNextFrame(const VideoFrame& frame, bool restart) {
+  webrtc::MutexLock lock(&mutex_);
+
+  if (restart){
+    Reset();
+    last_key_frame_id_ = frame.id();
+  }
+  current_frame_id_ = frame.id();
+  frame_count_++;
+}
