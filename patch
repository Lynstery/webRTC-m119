-      avg_u32 = vpadal_u16(avg_u32, avg_u16);
-
-      h_limit += h_overflow;
-      h_limit = height > h_overflow ? h_overflow : height;
-    } while (h < height);
-    return (uint8_t)((horizontal_long_add_u32x2(avg_u32) + sum) /
-                     (width * height));
-  }
-  int i = height;
-  do {
-    int j = 0;
-    do {
-      sum += src[j];
