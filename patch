+      CONSTRAIN(s2, sec_strength, sec_damping);
+      MIN_MAX(s2);
+      UPDATE_SUM(s2);
+
+      // Store
+      STORE16_4_CLAMPED;
+
+      h -= 2;
+    } while (h != 0);
+  }
+}
