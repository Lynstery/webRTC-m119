+template <size_t Width, int Scale, typename D>
+HWY_ATTR HWY_INLINE void IdtxSqrt2(D tag, hn::TFromD<D> *HWY_RESTRICT in) {
+  for (size_t x = 0; x < Width; x += hn::MaxLanes(tag)) {
