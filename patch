+              load_unaligned_u32_4x1_lane(ret1_u32, left + idx6, 2);
+              if (n > 7) {
+                load_unaligned_u32_4x1_lane(ret1_u32, left + idx7, 3);
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+  return vuzpq_u16(vreinterpretq_u16_u32(ret0_u32),
+                   vreinterpretq_u16_u32(ret1_u32));
+}
