+  scaled_convolve_horiz_neon_i8mm(src - horiz_offset - vert_offset, src_stride,
+                                  im_block, im_stride, filter, x0_q4, x_step_q4,
+                                  w, im_height);
+
+  scaled_convolve_vert_neon_i8mm(im_block, im_stride, dst, dst_stride, filter,
+                                 y0_q4, y_step_q4, w, h);
