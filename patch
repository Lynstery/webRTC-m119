-bool ForwardErrorCorrection::RecoverPacket(const ReceivedFecPacket& fec_packet,
-                                           RecoveredPacket* recovered_packet) {
-  if (!StartPacketRecovery(fec_packet, recovered_packet)) {
-    return false;
