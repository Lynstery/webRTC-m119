+static AOM_FORCE_INLINE void highbd_fidentity4_x4_neon(const int32x4_t *in,
+                                                       int32x4_t *out,
+                                                       int bit) {
+  (void)bit;
+  int32x4_t fact = vdupq_n_s32(NewSqrt2);
+
+  for (int i = 0; i < 4; i++) {
+    const int32x4_t a_low = vmulq_s32(in[i], fact);
+    out[i] = vrshrq_n_s32(a_low, NewSqrt2Bits);
+  }
+}
