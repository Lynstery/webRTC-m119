+template <>
+struct RoundShiftTraits<true> {
+  template <int Bit, typename D>
+  HWY_ATTR HWY_INLINE static hn::VFromD<D> Shift(D int_tag,
+                                                 hn::VFromD<D> value) {
+    (void)int_tag;
+    if CONSTEXPR_IF (Bit == 0) {
+      return value;
+    } else {
+      return hn::ShiftLeft<Bit>(value);
+    }
+  }
+};
