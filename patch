+static inline void madd_neon(int32x4_t *sum, const int16x8_t src,
+                             const int16x8_t dgd) {
+  *sum = vmlal_s16(*sum, vget_low_s16(src), vget_low_s16(dgd));
+  *sum = vmlal_s16(*sum, vget_high_s16(src), vget_high_s16(dgd));
