+  exit(1);
+}
+
+int main(int argc, char **argv)
+{
+  unsigned char *x, *y;
+  unsigned short *xs, *ys;
+  unsigned int *xi, *yi;
+  uint32_t seed;
+  int *a32, *copy;
+  int i;
+  int w;
+  
