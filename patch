+  s += p;
+  *s1 = __riscv_vle8_v_u8mf2(s, vl);
+  s += p;
+  *s2 = __riscv_vle8_v_u8mf2(s, vl);
+  s += p;
+  *s3 = __riscv_vle8_v_u8mf2(s, vl);
+  s += p;
+  *s4 = __riscv_vle8_v_u8mf2(s, vl);
+  s += p;
+  *s5 = __riscv_vle8_v_u8mf2(s, vl);
+  s += p;
+  *s6 = __riscv_vle8_v_u8mf2(s, vl);
+  s += p;
+  *s7 = __riscv_vle8_v_u8mf2(s, vl);
