+          uint8x16_t m;
+          if (inverse) {
+            m = vqsubq_u8(mask_diff, diff);
+          } else {
+            m = vminq_u8(vaddq_u8(diff, mask_base), max_alpha);
+          }
+
+          vst1q_u8(mask_ptr, m);
+
+          src0_ptr += 16;
+          src1_ptr += 16;
+          mask_ptr += 16;
+          width -= 16;
+        } while (width != 0);
